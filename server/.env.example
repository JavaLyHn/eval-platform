DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/qa_platform
SERVER_PORT=18791
SERVER_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLATFORM_BASE_URL=
PLATFORM_API_KEY=
PLATFORM_REQUEST_TIMEOUT=300
PLATFORM_NAMESPACE=/open/agent

# --- 登录 / 鉴权 ---
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_EMAIL_DOMAINS=example.com
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
# 忘记密码(Gmail SMTP);留空 = 不发信(降级,不报错)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
MAIL_FROM=
APP_BASE_URL=http://127.0.0.1:5173

# Google 登录(OAuth2 授权码流);三项齐全才启用,留空 = 「未配置」分支。
# 在 Google Cloud Console 建「Web 应用」OAuth 客户端,Authorized redirect URIs 填:
#   dev:  http://localhost:5173/v1/auth/google/callback
#   prod: https://<域名>/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/v1/auth/google/callback
